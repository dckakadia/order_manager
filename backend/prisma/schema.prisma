generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id            Int      @id @default(autoincrement())
  category      String   @default("Model")
  name          String
  price         Float    @default(0)
  silverPrice   Float?
  goldPrice     Float?
  platinumPrice Float?
  titaniumPrice Float?
  isActive      Boolean  @default(true)
  photo_filename String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model Customer {
  id               Int      @id @default(autoincrement())
  name             String
  phone            String?
  email            String?
  shippingAddress  String?
  taxNumber        String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]
}

model Order {
  id               Int      @id @default(autoincrement())
  customerId       Int
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  baseModel        String?
  itemId           Int?
  item             Item? @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant          String?
  basePrice        Float    @default(0)
  totalPrice       Float    @default(0)

  // NEW FIELD: Notes for special instructions or customizations
  notes            String?

  faucetPosition   String?
  sidePanel        String?
  orderBy          String?

  locationLat      Float?
  locationLng      Float?
  checkInTime      DateTime?
  deliveryDate     DateTime?

  status           String   @default("Order Form Received")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
  statusHistory    OrderStatusHistory[]
  attachments      OrderAttachment[]

  // PHASE 3: Add indexes for frequently queried fields
  @@index([status])
  @@index([deliveryDate])
  @@index([createdAt])
  @@index([deletedAt])
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  pin       String
  role      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  statusChanges OrderStatusHistory[]
  attachments   OrderAttachment[]
  deviceTokens  DeviceToken[]
  pagePermissions UserPagePermission[]
  notifications   Notification[]
}

// Per-user, per-page view/edit/delete rights. 'users' page is never stored here —
// access to user management is hardcoded ADMIN-only, not customizable.
model UserPagePermission {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  page      String   // sales | customers | status | delivered | report | dashboard | items
  canView   Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, page])
  @@index([userId])
}

// Registered FCM device tokens for push notifications
model DeviceToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// In-app notification history — persisted independently of push delivery so a user
// still has a record of order events even without a registered device token or with
// push notifications denied/unconfigured (see pushService.js for the FCM side).
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // 'new_order' | 'status_updated'
  title     String
  body      String
  orderId   Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// PHASE 3: Audit logging for compliance and security
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     // User who performed the action
  username  String?  // Username for reference
  action    String   // e.g., 'CREATE_ORDER', 'UPDATE_CUSTOMER', 'DELETE_ITEM'
  resource  String   // e.g., 'Order', 'Customer', 'Item'
  resourceId Int?    // ID of the resource being modified
  changes   String?  // JSON diff of what changed
  status    String   @default("success") // 'success' or 'failure'
  errorMsg  String?  // Error message if action failed
  ipAddress String?  // IP address of requester
  userAgent String?  // Browser/client info
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// PHASE 4: Order Status History Tracking
model OrderStatusHistory {
  id              Int      @id @default(autoincrement())
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus  String?  // Null if this is the initial creation
  newStatus       String
  changedByUserId Int?
  user            User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  timestamp       DateTime @default(now())
  
  @@index([orderId])
  @@index([timestamp])
}

model OrderAttachment {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileName    String
  filePath    String
  uploadedBy  Int?
  user        User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  // NEW FIELDS
  photoLat    Float?   // GPS latitude at time of photo
  photoLng    Float?   // GPS longitude at time of photo
  photoType   String?  // e.g. "location_photo" or "general"
  
  @@index([orderId])
}
