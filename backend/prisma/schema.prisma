generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id            Int      @id @default(autoincrement())
  category      String   @default("Model")
  name          String
  price         Float    @default(0)
  silverPrice   Float?
  goldPrice     Float?
  platinumPrice Float?
  titaniumPrice Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Customer {
  id               Int      @id @default(autoincrement())
  name             String
  phone            String?
  email            String?
  shippingAddress  String?
  taxNumber        String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Order {
  id               Int      @id @default(autoincrement())
  customerName     String?
  phone            String?
  email            String?
  shippingAddress  String?
  taxNumber        String?

  baseModel        String?
  variant          String?
  basePrice        Float    @default(0)
  totalPrice       Float    @default(0)

  // NEW FIELD: Notes for special instructions or customizations
  notes            String?

  faucetPosition   String?
  sidePanel        String?
  orderBy          String?

  locationLat      Float?
  locationLng      Float?
  checkInTime      DateTime?
  deliveryDate     DateTime?

  status           String   @default("Order Form Received")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // PHASE 3: Add indexes for frequently queried fields
  @@index([status])
  @@index([deliveryDate])
  @@index([createdAt])
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  pin       String
  role      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// PHASE 3: Audit logging for compliance and security
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     // User who performed the action
  username  String?  // Username for reference
  action    String   // e.g., 'CREATE_ORDER', 'UPDATE_CUSTOMER', 'DELETE_ITEM'
  resource  String   // e.g., 'Order', 'Customer', 'Item'
  resourceId Int?    // ID of the resource being modified
  changes   String?  // JSON diff of what changed
  status    String   @default("success") // 'success' or 'failure'
  errorMsg  String?  // Error message if action failed
  ipAddress String?  // IP address of requester
  userAgent String?  // Browser/client info
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
